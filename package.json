{
  "name": "inkstory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "node tools/check-build.mjs",
    "test:e2e": "playwright test",
    "test:privacy": "playwright test --grep privacy",
    "test:capture": "playwright test --config playwright.capture.config.ts",
    "motion:convert:all": "node tools/motion-pipeline/convert-all.mjs",
    "test:hosting": "playwright test --config playwright.hosting.config.ts"
  },
  "dependencies": {
    "cdt2d": "^1.0.0",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "onnxruntime-web": "^1.29.0",
    "pixi.js": "^8.20.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
